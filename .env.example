# ==============================================================================
# Baatcheet Environment Configuration
# ==============================================================================

# [SERVER-ONLY] Google Gemini API Key for question generation, turn decisions, and report analysis.
# Never expose this to the browser or prefix with VITE_. Set in Vercel Project Settings for production.
GEMINI_API_KEY=

# [SERVER-ONLY] Primary model to try first (default: gemini-3.6-flash).
# Optional: gemini-3.6-flash, gemini-3.5-flash, gemini-3.1-flash-lite, etc.
GEMINI_MODEL=

# [SERVER-ONLY] Comma-separated fallback models in order of attempt (optional).
GEMINI_FALLBACK_MODEL=

# [SERVER-ONLY] Custom Gemini base URL (optional, defaults to https://generativelanguage.googleapis.com).
GEMINI_BASE=

# [SERVER-ONLY] Server port when running standalone Node server (optional, default: 3000).
PORT=
